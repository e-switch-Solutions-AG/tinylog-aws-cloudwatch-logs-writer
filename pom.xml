<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ch.eswitch.tinylog.writers</groupId>
    <artifactId>tinylog-aws-cloudwatch-logs-writer</artifactId>
    <!-- Jakarta EE / Tomcat 11 line: the "-jakartaee" suffix keeps it apart from the javax line (main, Tomcat 9),
         same scheme as xrb (e.g. xrb-11.6.0-jakartaee). -->
    <version>1.0.31-jakartaee</version>

    <packaging>jar</packaging>

    <name>tinylog AWS CloudWatch Logs Writer</name>
    <description>tinylog 2 AWS CloudWatch Logs Writer based on Amazon SDK for Java 2.x</description>
    <url>https://github.com/e-switch-Solutions-AG/tinylog-aws-cloudwatch-logs-writer</url>
    <organization>
        <name>e-switch Solutions AG</name>
        <url>https://e-switch.ch/en/</url>
    </organization>

    <properties>
        <timestamp>${maven.build.timestamp}</timestamp>
        <maven.build.timestamp.format>yyyy-MM-dd</maven.build.timestamp.format>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>17</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <tomcat.version>11.0.27</tomcat.version>
        <aws.sdk.version>2.57.10</aws.sdk.version>
        <!-- HTTP5 and slf4j-api: same versions as xrb / the host webapp (e-companion WEB-INF/lib) -->
        <httpclient5.version>5.6.5</httpclient5.version>
        <httpcore5.version>5.4.4</httpcore5.version>
        <slf4j.version>2.0.11</slf4j.version>
        <tinylog.version>2.8.1</tinylog.version>
    </properties>

    <profiles>
        <profile>
            <id>jdk17</id>
            <activation>
                <jdk>[17,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <executions>
                            <execution>
                                <id>generate-javadocs</id>
                                <goals>
                                    <goal>javadoc</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <show>package</show>
                            <detectLinks>true</detectLinks>
                            <links>
                                <link>https://sdk.amazonaws.com/java/api/latest</link>
                            </links>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <configuration>
                                    <classifier>javadoc</classifier>
                                    <classesDirectory>${project.build.directory}/reports/apidocs</classesDirectory>
                                    <outputDirectory>${project.build.directory}</outputDirectory>
                                </configuration>
                                <id>pack-javadoc</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>copy-resources-md</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <overwrite>true</overwrite>
                                    <outputDirectory>${basedir}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>src/main/resources</directory>
                                            <includes>
                                                <include>README.md</include>
                                            </includes>
                                            <filtering>true</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.5.6</version>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>snyk</id>
            <build>
                <plugins>
                    <!-- https://github.com/snyk/snyk-maven-plugin -->
                    <!-- https://docs.snyk.io/integrations/ci-cd-integrations/maven-plugin-integration -->
                    <plugin>
                        <groupId>io.snyk</groupId>
                        <artifactId>snyk-maven-plugin</artifactId>
                        <version>2.3.0</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>snyk-test</id>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>snyk-code-test</id>
                                <goals>
                                    <goal>code-test</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <apiToken>${env.SNYK_TOKEN}</apiToken>
                            <args>
                                <arg>--print-deps</arg>
                                <arg>--fail-on=all</arg>
                                <arg>--json-file-output=snyk-result.json</arg>
                            </args>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>


    <dependencyManagement>
        <dependencies>
            <!-- HTTP5: apache5-client 2.57.10 brings httpclient5 5.6.4 / httpcore5 5.4.3.
                 < 5.6.3 leaks connections on Content-Encoding decode errors (GHSA-hjcp-jmpx-g3qm). -->
            <dependency>
                <groupId>org.apache.httpcomponents.client5</groupId>
                <artifactId>httpclient5</artifactId>
                <version>${httpclient5.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5</artifactId>
                <version>${httpcore5.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5-h2</artifactId>
                <version>${httpcore5.version}</version>
            </dependency>
            <!-- AWS SDK and httpclient5 bring slf4j-api 1.7.36; the host webapp ships 2.x -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Compile dependencies -->
        <!-- The web log viewer (servlet, JSP, Bootstrap, JSTL, gson, commons-lang3) was removed in 1.0.31-jakartaee. -->
        <dependency>
            <groupId>org.glassfish</groupId>
            <artifactId>jakarta.json</artifactId>
            <version>2.0.1</version>
        </dependency>
        <dependency>
            <groupId>org.tinylog</groupId>
            <artifactId>tinylog-api</artifactId>
            <version>${tinylog.version}</version>
        </dependency>
        <dependency>
            <groupId>org.tinylog</groupId>
            <artifactId>tinylog-impl</artifactId>
            <version>${tinylog.version}</version>
        </dependency>
        <!-- Sync HTTP client of the AWS SDK: Apache HttpClient 5 (HTTP5) only.
             HTTP4 (apache-client, httpclient 4.x, httpcore 4.x) is banned by the enforcer rule below. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apache5-client</artifactId>
            <version>${aws.sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cloudwatch</artifactId>
            <version>${aws.sdk.version}</version>
            <exclusions>
                <!-- async HTTP client (netty) is not used, only the sync CloudWatchLogsClient -->
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cloudwatchlogs</artifactId>
            <version>${aws.sdk.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Provided dependencies -->
        <!-- Servlet API: AwsCloudWatchLogsJsonWriter.getCombinedOutputLogEvents(String, HttpServletRequest) reads log
             events back (used by the integration test); provided by Tomcat, never in target/lib. -->
        <dependency>
            <groupId>org.apache.tomcat</groupId>
            <artifactId>tomcat-servlet-api</artifactId>
            <version>${tomcat.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
        <!--
        <dependency>
            <groupId>org.tinylog</groupId>
            <artifactId>slf4j-tinylog</artifactId>
            <version>2.7.0</version>
            <scope>test</scope>
        </dependency>
        -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>enforce-http5-only</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <message>Only HTTP5 (org.apache.httpcomponents.client5/core5) is allowed. HTTP3/HTTP4 and the AWS SDK apache-client must not come back, also not transitively.</message>
                                    <excludes>
                                        <exclude>commons-httpclient:*</exclude>
                                        <exclude>org.apache.httpcomponents:*</exclude>
                                        <exclude>software.amazon.awssdk:apache-client</exclude>
                                    </excludes>
                                </bannedDependencies>
                                <bannedDependencies>
                                    <message>Container (Tomcat) APIs must stay in provided scope, they must not be copied to target/lib.</message>
                                    <excludes>
                                        <exclude>jakarta.servlet:*:*:*:compile</exclude>
                                        <exclude>jakarta.servlet:*:*:*:runtime</exclude>
                                        <exclude>jakarta.servlet.jsp:*:*:*:compile</exclude>
                                        <exclude>jakarta.servlet.jsp:*:*:*:runtime</exclude>
                                        <exclude>jakarta.el:*:*:*:compile</exclude>
                                        <exclude>jakarta.el:*:*:*:runtime</exclude>
                                        <exclude>org.apache.tomcat*:*:*:*:compile</exclude>
                                        <exclude>org.apache.tomcat*:*:*:*:runtime</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <phase>install</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <!-- runtime = compile + runtime scope: full copy of everything the writer needs at runtime,
                                 without provided (Tomcat) and test jars. ("compile" would include provided jars.) -->
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- target/lib-xrb: like target/lib, but without the libraries the xrb WAR already ships,
                     see src/assembly/lib-xrb.xml (groupId:artifactId matching, which copy-dependencies cannot do) -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.8.0</version>
                <executions>
                    <execution>
                        <id>lib-xrb</id>
                        <phase>install</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/lib-xrb.xml</descriptor>
                            </descriptors>
                            <finalName>lib-xrb</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                            <attach>false</attach>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github_packages</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/e-switch-Solutions-AG/tinylog-aws-cloudwatch-logs-writer</url>
        </repository>
        <!--
        <repository>
            <id>eswitch-artifactory-release-public</id>
            <name>libs-release-public</name>
            <url>https://artifactory.e-switch.ch/artifactory/libs-release-public</url>
        </repository>
        -->
    </distributionManagement>

</project>